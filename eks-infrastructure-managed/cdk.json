{
  "app": "npx tsx bin/eks-managed.ts",
  "toolkitStackName": "CDKToolkit-ManagedIdp",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "yarn.lock",
      "node_modules",
      "test"
    ]
  },
  "context": {
    "@aws-cdk/core:bootstrapQualifier": "mgdidp",
    "@aws-cdk/core:crossRegionReferences": true,
    "@aws-cdk/core:defaultCrossStackReferences": "strong",
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": [
      "aws",
      "aws-cn"
    ],
    "@aws-cdk/aws-ec2:uniqueImdsv2TemplateName": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/core:enablePartitionLiterals": true,
    "@aws-cdk/aws-iam:standardizedServicePrincipals": true,
    "managedIdp": {
      "region": "us-west-2",
      "clusterName": "lockheadcloud-managed",
      "kubernetesVersion": "1.36",
      "vpcMaxAzs": 3,
      "vpcNatGateways": 1,
      "gitProvider": "codecommit",
      "repositoryName": "lockheadcloud-managed-platform",
      "serviceRepoPrefix": "svc-",
      "portal": true,
      "idcInstanceArn": "",
      "idcRegion": "",
      "idcAdminUserId": "",
      "idcAdminGroupId": ""
    }
  }
}
