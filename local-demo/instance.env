# shellcheck shell=bash
# Per-instance identity + port block for this local demo.
#
# Every script in local-demo/ sources this file, so two copies of the demo (or
# this one and the original) can run on the same machine at the same time.
# Anything that must be unique per instance lives here:
#
#   * kind cluster / kube context name  (DEMO_NAME → kind-<DEMO_NAME>)
#   * kubeconfig file                   (own file, so `kubectl config use-context`
#                                        in one instance never flips the other)
#   * host ports                        (ingress, gitea NodePort, port-forwards,
#                                        dashboard, action backend, app forward)
#
# Override any value from the environment, e.g.:
#   DEMO_NAME=demo3 IDP_PORT=8743 ./start.sh
# (if you change ports, also keep every later script run in the same shell/env).
#
# The original demo uses: name lockheadcloud, ports 8543 32223 18180 3100 7107
# 5656 9190 8011 8012 8080. This instance is shifted by +100 and named com323.
# Pick a different block of 100 for a third instance.

DEMO_NAME="${DEMO_NAME:-com323}"
_demo_kind_ctx="kind-${DEMO_NAME}"

if [[ -z "${KUBE_CONTEXT:-}" || "${KUBE_CONTEXT}" == "${_demo_kind_ctx}" ]]; then
  # Local kind instance: own context + own kubeconfig file.
  KUBE_CONTEXT="${_demo_kind_ctx}"
  DEMO_KUBECONFIG="${DEMO_KUBECONFIG:-${HOME}/.kube/${_demo_kind_ctx}.yaml}"
  mkdir -p "$(dirname "${DEMO_KUBECONFIG}")"
  export KUBECONFIG="${DEMO_KUBECONFIG}" DEMO_KUBECONFIG
  _d_idp=8643; _d_gitea_host=32323; _d_argocd=18280; _d_gitea=3200; _d_backstage=7207
  _d_dex=5756; _d_crossview=9290; _d_dash=8111; _d_ctl=8112; _d_app=8180
else
  unset DEMO_KUBECONFIG
  if [[ "${KUBE_CONTEXT}" == kind-* ]]; then
    echo "instance.env: KUBE_CONTEXT=${KUBE_CONTEXT} is exported in this shell and differs from kind-${DEMO_NAME}; using it with the original port block. Unset it to target this instance." >&2
  fi
  # The demo scripts are also driven against another cluster (eks-infrastructure/
  # scripts/ui.sh sets KUBE_CONTEXT to the EKS context). Keep the kubeconfig and
  # the port block that script uses.
  _d_idp=8543; _d_gitea_host=32223; _d_argocd=18180; _d_gitea=3100; _d_backstage=7107
  _d_dex=5656; _d_crossview=9190; _d_dash=8011; _d_ctl=8012; _d_app=8080
fi

IDP_PORT="${IDP_PORT:-${_d_idp}}"                    # ingress-nginx / idpbuilder web UIs (https://*.cnoe.localtest.me:PORT)
GITEA_HOST_PORT="${GITEA_HOST_PORT:-${_d_gitea_host}}" # kind host port for the gitea NodePort 32222
ARGOCD_PORT="${ARGOCD_PORT:-${_d_argocd}}"           # kubectl port-forward → argocd-server
GITEA_PORT="${GITEA_PORT:-${_d_gitea}}"              # kubectl port-forward → gitea http
BACKSTAGE_PORT="${BACKSTAGE_PORT:-${_d_backstage}}"  # kubectl port-forward → backstage
DEX_PORT="${DEX_PORT:-${_d_dex}}"                    # kubectl port-forward → dex (OIDC issuer for Backstage)
CROSSVIEW_PORT="${CROSSVIEW_PORT:-${_d_crossview}}"  # kubectl port-forward → crossview
DASH_PORT="${DASH_PORT:-${_d_dash}}"                 # kubectl proxy: dashboard pages + k8s API
CTL_PORT="${CTL_PORT:-${_d_ctl}}"                    # dashboard-server.py action backend
APP_PORT="${APP_PORT:-${_d_app}}"                    # local port-forward to an onboarded app

export DEMO_NAME KUBE_CONTEXT IDP_PORT GITEA_HOST_PORT ARGOCD_PORT GITEA_PORT \
       BACKSTAGE_PORT DEX_PORT CROSSVIEW_PORT DASH_PORT CTL_PORT APP_PORT
unset _demo_kind_ctx _d_idp _d_gitea_host _d_argocd _d_gitea _d_backstage _d_dex _d_crossview _d_dash _d_ctl _d_app

# ─── port rewriting for static files ──────────────────────────────────────────
# The HTML/JS pages, the Backstage manifest and the Backstage templates/skeleton
# are shared with the original demo and with eks-infrastructure/, so they keep
# the ORIGINAL port numbers in the repo. Scripts rewrite them to this instance's
# values on the way out (served by ui.sh, applied by start.sh, pushed to Gitea by
# setup_*.sh / reload-template.sh). With the original values this is a no-op.
#
#   demo_rewrite_ports                 stdin → stdout
#   demo_rewrite_ports_in_tree <dir>   rewrite every file under <dir> in place
_demo_port_rules='
  s/\b18180\b/$ENV{ARGOCD_PORT}/g;
  s/\b3100\b/$ENV{GITEA_PORT}/g;
  s/\b7107\b/$ENV{BACKSTAGE_PORT}/g;
  s/\b9190\b/$ENV{CROSSVIEW_PORT}/g;
  s/\b8011\b/$ENV{DASH_PORT}/g;
  s/\b8012\b/$ENV{CTL_PORT}/g;
  s/\b8543\b/$ENV{IDP_PORT}/g;
  s/(localhost:|TCP6-LISTEN:)5656\b/$1$ENV{DEX_PORT}/g;
  s/\b8080:80\b/$ENV{APP_PORT}:80/g;
  s/localhost:8080\b/localhost:$ENV{APP_PORT}/g;
  s/port: \x278080\x27/port: \x27$ENV{APP_PORT}\x27/g;
  s/kind-lockheadcloud/$ENV{KUBE_CONTEXT}/g;
'
demo_rewrite_ports() { perl -pe "${_demo_port_rules}"; }
demo_rewrite_ports_in_tree() {
  find "$1" -type f ! -name '*.png' ! -name '*.ico' -exec perl -pi -e "${_demo_port_rules}" {} +
}

# ─── kubeconfig handling around idpbuilder ────────────────────────────────────
# idpbuilder (0.10.x) hardcodes ~/.kube/config: it writes the new context there
# and reads it back from there, ignoring KUBECONFIG. So idpbuilder always runs
# WITHOUT KUBECONFIG, and the finished context is then copied into this
# instance's own kubeconfig (DEMO_KUBECONFIG), which every other script uses.
#
#   demo_idpbuilder <args…>      run idpbuilder against ~/.kube/config
#   demo_import_kubeconfig       copy this instance's context out of ~/.kube/config
#   demo_forget_kubeconfig       drop it from both files (after deleting the cluster)
demo_idpbuilder() { env -u KUBECONFIG idpbuilder "$@"; }
demo_import_kubeconfig() {
  [[ -n "${DEMO_KUBECONFIG:-}" ]] || return 0
  env -u KUBECONFIG kubectl config get-contexts "${KUBE_CONTEXT}" >/dev/null 2>&1 || return 1
  local tmp
  tmp="$(mktemp "${DEMO_KUBECONFIG}.XXXXXX")"
  if env -u KUBECONFIG kubectl config view --raw --minify --flatten --context "${KUBE_CONTEXT}" > "${tmp}" 2>/dev/null; then
    chmod 600 "${tmp}"; mv "${tmp}" "${DEMO_KUBECONFIG}"
  else
    rm -f "${tmp}"; return 1
  fi
}
demo_forget_kubeconfig() {
  env -u KUBECONFIG kubectl config delete-context "${KUBE_CONTEXT}" >/dev/null 2>&1 || true
  env -u KUBECONFIG kubectl config delete-cluster "${KUBE_CONTEXT}" >/dev/null 2>&1 || true
  env -u KUBECONFIG kubectl config delete-user    "${KUBE_CONTEXT}" >/dev/null 2>&1 || true
  [[ -n "${DEMO_KUBECONFIG:-}" ]] && rm -f "${DEMO_KUBECONFIG}"
  return 0
}
